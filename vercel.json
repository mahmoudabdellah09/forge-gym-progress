{
  "version": 2,
  "installCommand": "cd gym-progress-app && npm ci",
  "buildCommand": "cd gym-progress-app && npm run build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "gym-progress-app/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/gym-progress-app/$1"
    }
  ]
}
